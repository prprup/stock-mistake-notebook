/* 广场详情页面样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

/* 作者信息 */
.author-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.author-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.post-time {
  font-size: 26rpx;
  color: #999;
}

/* 内容卡片 */
.content-card {
  background: #fff;
  padding: 30rpx;
  margin-top: 2rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background: #ffe5e9;
  color: #e94560;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 10rpx;
}

.reflection {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.emotion {
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.emotion-label {
  font-size: 26rpx;
  color: #999;
}

.emotion-value {
  font-size: 28rpx;
  color: #667eea;
  font-weight: bold;
}

/* 操作栏 */
.action-bar {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}