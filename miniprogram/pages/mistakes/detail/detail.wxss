/* 错题详情页面样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

/* 股票卡片 */
.stock-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stock-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stock-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.stock-code {
  font-size: 28rpx;
  color: #999;
}

.trade-info {
  display: flex;
  flex-wrap: wrap;
}

.trade-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.value {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.value.buy {
  color: #e94560;
}

.value.sell {
  color: #059669;
}

/* 分区 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 12rpx 24rpx;
  background: #ffe5e9;
  color: #e94560;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

/* 情绪 */
.emotion {
  font-size: 32rpx;
  color: #667eea;
  padding: 20rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
  display: inline-block;
}

/* 反思 */
.reflection {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

/* 截图 */
.screenshot {
  width: 100%;
  border-radius: 12rpx;
}