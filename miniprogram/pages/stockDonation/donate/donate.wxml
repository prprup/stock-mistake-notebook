<!-- 股票打赏页面 -->
<view class="container">
  <!-- 头部信息 -->
  <view class="header">
    <view class="points-display">
      <text class="points-label">我的积分</text>
      <text class="points-value">{{userPoints}}</text>
    </view>
    <view class="nav-buttons">
      <view class="nav-btn" bindtap="goToRanking">
        <text class="nav-icon">🏆</text>
        <text class="nav-text">排行榜</text>
      </view>
      <view class="nav-btn" bindtap="goToMyDonations">
        <text class="nav-icon">📜</text>
        <text class="nav-text">我的打赏</text>
      </view>
    </view>
  </view>

  <!-- 搜索区域 -->
  <view class="search-section">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="输入股票代码或名称"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        focus
      />
      <view class="search-icon">🔍</view>
    </view>

    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{searchResults.length > 0}}">
      <view
        class="stock-item"
        wx:for="{{searchResults}}"
        wx:key="code"
        bindtap="selectStock"
        data-stock="{{item}}"
      >
        <text class="stock-code">{{item.code}}</text>
        <text class="stock-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 搜索中 -->
    <view class="search-loading" wx:if="{{searching}}">
      <text>搜索中...</text>
    </view>
  </view>

  <!-- 选中的股票 -->
  <view class="selected-stock" wx:if="{{selectedStock}}">
    <view class="stock-info">
      <text class="stock-name">{{selectedStock.name}}</text>
      <text class="stock-code">{{selectedStock.code}}</text>
    </view>
    <view class="clear-btn" bindtap="clearSelectedStock">✕</view>
  </view>

  <!-- 打赏金额 -->
  <view class="donation-section" wx:if="{{selectedStock}}">
    <view class="section-title">选择打赏积分</view>
    
    <!-- 快捷金额 -->
    <view class="quick-amounts">
      <view
        class="amount-item {{points === item ? 'active' : ''}}"
        wx:for="{{quickAmounts}}"
        wx:key="*this"
        bindtap="selectQuickAmount"
        data-amount="{{item}}"
      >
        {{item}}
      </view>
    </view>
    
    <!-- 自定义金额 -->
    <view class="custom-amount">
      <text class="amount-label">自定义：</text>
      <input
        class="amount-input"
        type="number"
        value="{{points}}"
        bindinput="onPointsInput"
        placeholder="输入积分"
      />
    </view>
    
    <!-- 留言 -->
    <view class="section-title">留言（可选）</view>
    <input
      class="message-input"
      placeholder="说点什么..."
      value="{{message}}"
      bindinput="onMessageInput"
      maxlength="50"
    />
    
    <!-- 提交按钮 -->
    <view 
      class="submit-btn {{points <= 0 || points > userPoints ? 'disabled' : ''}}"
      bindtap="submitDonation"
    >
      {{points <= 0 ? '请输入积分' : points > userPoints ? '积分不足' : '确认打赏 ' + points + ' 积分'}}
    </view>
  </view>

  <!-- 提示 -->
  <view class="tips" wx:if="{{!selectedStock}}">
    <view class="tip-item">
      <text class="tip-icon">💡</text>
      <text class="tip-text">搜索并选择股票后可以进行打赏</text>
    </view>
    <view class="tip-item">
      <text class="tip-icon">🏆</text>
      <text class="tip-text">打赏越多，股票在排行榜上排名越高</text>
    </view>
    <view class="tip-item">
      <text class="tip-icon">⚠️</text>
      <text class="tip-text">打赏积分一旦消耗无法退回</text>
    </view>
  </view>
</view>