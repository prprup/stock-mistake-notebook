<!-- 我的打赏记录页面 -->
<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-card" wx:if="{{stats}}">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalDonated}}</text>
      <text class="stat-label">累计打赏</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.stockCount}}</text>
      <text class="stat-label">打赏股票</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.donationCount}}</text>
      <text class="stat-label">打赏次数</text>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="records-list">
    <view class="section-title">打赏记录</view>
    
    <view
      class="record-item"
      wx:for="{{records}}"
      wx:key="_id"
    >
      <view class="record-left">
        <text class="stock-name">{{item.stockName}}</text>
        <text class="stock-code">{{item.stockCode}}</text>
        <text class="record-time">{{item.formattedTime}}</text>
      </view>
      
      <view class="record-right">
        <text class="donation-points">-{{item.points}}</text>
        <text class="donation-message" wx:if="{{item.message}}">{{item.message}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
    <text>没有更多记录了</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">还没有打赏记录</text>
    <text class="empty-sub">去打赏你喜欢的股票吧~</text>
    <view class="donate-btn" bindtap="goToDonate">去打赏</view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer" wx:if="{{records.length > 0}}">
    <view class="footer-btn" bindtap="goToDonate">
      <text>💰 去打赏</text>
    </view>
    <view class="footer-btn secondary" bindtap="goToRanking">
      <text>🏆 排行榜</text>
    </view>
  </view>
</view>