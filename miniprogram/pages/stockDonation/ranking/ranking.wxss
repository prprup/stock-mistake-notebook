/* 股票打赏排行榜页面样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 我的统计 */
.my-stats {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.my-stats.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
}

.donate-btn-small {
  background: rgba(255, 255, 255, 0.2);
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.stat-value.text-small {
  font-size: 32rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 周期筛选 */
.period-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

/* 排行榜列表 */
.ranking-list {
  padding: 0 30rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  position: relative;
}

.rank-item.my-donation {
  background: linear-gradient(135deg, #fff9e6 0%, #fff 100%);
  border: 2rpx solid #ffd700;
}

.rank-item.gold {
  background: linear-gradient(135deg, #fff9e6 0%, #fff 60%);
}

.rank-item.silver {
  background: linear-gradient(135deg, #f5f5f5 0%, #fff 60%);
}

.rank-item.bronze {
  background: linear-gradient(135deg, #fff5eb 0%, #fff 60%);
}

.rank-num {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
  font-weight: bold;
}

.rank-icon {
  font-size: 48rpx;
}

.stock-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.stock-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stock-code {
  font-size: 26rpx;
  color: #999;
}

.donation-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.donation-points {
  font-size: 32rpx;
  font-weight: bold;
  color: #e94560;
  margin-bottom: 8rpx;
}

.donor-count {
  font-size: 24rpx;
  color: #999;
}

.my-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: #667eea;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.donate-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 30rpx 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.footer-btn {
  flex: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  text-align: center;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.footer-btn:last-child {
  margin-right: 0;
}

.footer-btn.secondary {
  background: #f5f5f5;
  color: #666;
}