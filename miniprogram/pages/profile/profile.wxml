<!-- 个人中心页面 -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <image 
        class="avatar"
        src="{{userInfo ? userInfo.avatarUrl : '/images/default-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="user-name">
        <text>{{userInfo ? userInfo.nickName : '点击登录'}}</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalMistakes}}</text>
      <text class="stat-label">错题记录</text>
    </view>
    
    <view class="stat-item" bindtap="goToPoints">
      <text class="stat-value">{{stats.totalPoints}}</text>
      <text class="stat-label">累计积分</text>
    </view>
    
    <view class="stat-item">
      <text class="stat-value">{{stats.checkInStreak}}</text>
      <text class="stat-label">连续打卡</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToStockDonation">
      <text class="menu-icon">💰</text>
      <text class="menu-text">股票打赏</text>
      <text class="menu-arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="goToRanking">
      <text class="menu-icon">🏆</text>
      <text class="menu-text">打赏排行榜</text>
      <text class="menu-arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="goToPoints">
      <text class="menu-icon">🎁</text>
      <text class="menu-text">积分中心</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>